# IP Pública de tu instancia EC2 o dominio (ej: 54.210.12.34)
EC2_PUBLIC_IP=44.202.191.168

# Puertos expuestos en el host
PORT_POSTGRES=15442
PORT_BACKEND=4444
PORT_FRONTEND=3333

# Credenciales de PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cuidarteplus

# Configuración del Backend
NODE_ENV=production
JWT_SECRET=tu_clave_secreta_para_produccion
